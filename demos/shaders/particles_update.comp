// Draws: nothing; integrates every particle one step towards two orbiting attractors under gravity, respawning expired ones.
// Inputs: SSBO at binding 2, std430 array of { vec4 position (xyz, w = age 0..1), vec4 velocity (xyz, w = 1/lifetime), vec4 colour }, 48 bytes each.
// Uniforms (std140, binding 1): +0 vec4 attractor_a (xyz, w = strength), +16 vec4 attractor_b, +32 vec4 step (dt, gravity, damping, time), +48 uvec4 count (x = particle count).
#version 450

layout(local_size_x = 256) in;

struct Particle {
    vec4 position;
    vec4 velocity;
    vec4 colour;
};

layout(std430, set = 0, binding = 2) buffer Particles {
    Particle particles[];
};

layout(std140, set = 0, binding = 1) uniform Update {
    vec4 attractor_a;
    vec4 attractor_b;
    vec4 step;
    uvec4 count;
};

vec3 pull(vec3 p, vec4 attractor) {
    vec3 d = attractor.xyz - p;
    return d * (attractor.w / (dot(d, d) + 0.05));
}

float hash(uint n) {
    n = (n ^ 61u) ^ (n >> 16);
    n *= 9u;
    n ^= n >> 4;
    n *= 0x27d4eb2du;
    n ^= n >> 15;
    return float(n) * (1.0 / 4294967296.0);
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= count.x) {
        return;
    }
    Particle p = particles[i];
    float dt = step.x;
    vec3 accel = pull(p.position.xyz, attractor_a) + pull(p.position.xyz, attractor_b);
    accel.y -= step.y;
    vec3 velocity = (p.velocity.xyz + accel * dt) * step.z;
    vec3 position = p.position.xyz + velocity * dt;
    float age = p.position.w + p.velocity.w * dt;

    if (age >= 1.0) {
        uint seed = i * 3u + uint(step.w * 60.0) * 7919u;
        vec3 jitter = vec3(hash(seed), hash(seed + 1u), hash(seed + 2u)) - 0.5;
        position = attractor_a.xyz + jitter * 0.2;
        velocity = jitter * 4.0;
        age = 0.0;
    }

    float speed = length(velocity);
    vec3 hot = vec3(1.0, 0.55, 0.15);
    vec3 cold = vec3(0.2, 0.45, 1.0);
    particles[i].position = vec4(position, age);
    particles[i].velocity = vec4(velocity, p.velocity.w);
    particles[i].colour = vec4(mix(cold, hot, clamp(speed * 0.25, 0.0, 1.0)), 1.0 - age);
}
