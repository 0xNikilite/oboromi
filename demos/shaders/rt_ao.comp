// Computes: ray-traced ambient occlusion, a few cosine-weighted hemisphere rays per pixel against the scene's top-level acceleration structure.
// Inputs: the depth target at binding 2 (nearest, clamp); the acceleration structure at binding 3; writes one float per pixel (1 = open, 0 = occluded) row-major to the buffer at binding 4.
// Uniforms (std140, binding 1): +0 mat4 inv_view_proj (Vulkan clip space, z 0..1), +64 vec4 params (width, height, radius in world units, frame), +80 uvec4 rays (ray count, 0, 0, 0).
#version 460
#extension GL_EXT_ray_query : require

layout(local_size_x = 8, local_size_y = 8) in;

layout(std140, set = 0, binding = 1) uniform Ao {
    mat4 inv_view_proj;
    vec4 params;
    uvec4 rays;
};

layout(set = 0, binding = 2) uniform sampler2D depth;
layout(set = 0, binding = 3) uniform accelerationStructureEXT scene;
layout(std430, set = 0, binding = 4) writeonly buffer Occlusion {
    float ao[];
};

vec3 world_at(ivec2 p) {
    vec2 ndc = (vec2(p) + 0.5) / params.xy * 2.0 - 1.0;
    vec4 w = inv_view_proj * vec4(ndc, texelFetch(depth, p, 0).r, 1.0);
    return w.xyz / w.w;
}

uint hash(uint x) {
    x ^= x >> 16;
    x *= 0x7feb352du;
    x ^= x >> 15;
    x *= 0x846ca68bu;
    return x ^ (x >> 16);
}

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p, ivec2(params.xy)))) return;
    uint index = uint(p.y) * uint(params.x) + uint(p.x);
    if (texelFetch(depth, p, 0).r >= 1.0) {
        ao[index] = 1.0;
        return;
    }
    vec3 pos = world_at(p);
    vec3 n = normalize(cross(world_at(p + ivec2(1, 0)) - pos, world_at(p + ivec2(0, 1)) - pos));
    vec3 t = normalize(cross(abs(n.x) < 0.9 ? vec3(1, 0, 0) : vec3(0, 1, 0), n));
    vec3 b = cross(n, t);

    uint seed = hash(index ^ hash(uint(params.w)));
    float open = 0.0;
    for (uint i = 0u; i < rays.x; i++) {
        seed = hash(seed);
        float u = float(seed & 0xffffu) / 65536.0;
        float phi = float(seed >> 16) / 65536.0 * 6.2831853;
        vec3 dir = mat3(t, b, n) * vec3(cos(phi) * sqrt(u), sin(phi) * sqrt(u), sqrt(1.0 - u));
        rayQueryEXT q;
        rayQueryInitializeEXT(q, scene, gl_RayFlagsOpaqueEXT | gl_RayFlagsTerminateOnFirstHitEXT, 0xff, pos + n * 1e-3 * params.z, 0.0, dir, params.z);
        while (rayQueryProceedEXT(q)) {}
        open += rayQueryGetIntersectionTypeEXT(q, true) == gl_RayQueryCommittedIntersectionNoneEXT ? 1.0 : 0.0;
    }
    ao[index] = open / float(rays.x);
}
